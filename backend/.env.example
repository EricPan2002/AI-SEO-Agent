# 複製這個檔案為 .env 後填入真實值。.env 已被 .gitignore 排除，不會進版控。

# ── Gemini ─────────────────────────────────────
# 取得金鑰：https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# ── WordPress ──────────────────────────────────
# 站台網址（Local by Flywheel 建立的本機站台）
WP_BASE_URL=http://ai-seo.local
# WordPress 後台使用者名稱
WP_USERNAME=admin
# WP 後台 › 使用者 › 個人資料 › 應用程式密碼 產生，可留空格也可去掉
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
